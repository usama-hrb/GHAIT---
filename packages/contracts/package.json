{
  "name": "@fabric/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Zod schemas and shared types for the API and sync.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@fabric/config-eslint": "workspace:*",
    "@fabric/config-ts": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
