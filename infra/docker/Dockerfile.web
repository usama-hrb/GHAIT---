# syntax=docker/dockerfile:1
# Production image for apps/web (Next.js standalone server). Build from the repo root:
#   docker build -f infra/docker/Dockerfile.web -t fabric-shop-web .

ARG NODE_IMAGE=node:24.22.2-alpine

FROM ${NODE_IMAGE} AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    HUSKY=0 \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    npm_config_store_dir=/pnpm-store
RUN corepack enable
WORKDIR /repo

# Keep only the web app and the workspace packages it depends on.
FROM base AS pruner
COPY . .
RUN pnpm dlx "turbo@$(node -p "require('./package.json').devDependencies.turbo.replace(/^\D+/, '')")" \
      prune @fabric/web --docker

FROM base AS builder
COPY --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ ./
ENV NEXT_OUTPUT=standalone
RUN pnpm turbo run build --filter=@fabric/web

FROM ${NODE_IMAGE} AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
# Root-owned and read-only for the runtime user; only Next's cache dir is writable.
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /repo/apps/web/public ./apps/web/public
RUN mkdir -p apps/web/.next/cache && chown 1000:1000 apps/web/.next/cache
# 1000 = the image's unprivileged `node` user.
USER 1000:1000
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]
