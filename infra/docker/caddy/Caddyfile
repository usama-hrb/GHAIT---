{
	email {$ACME_EMAIL}

	# A browser sends no server name when it opens a bare IP address, and inside Docker Caddy sees
	# the container's address, not the server's, so it could not pick the certificate. This names
	# it. With a domain every browser sends the name and this changes nothing.
	default_sni {$DOMAIN}
}

# HTTPS certificates are issued automatically for {$DOMAIN} (Let's Encrypt; local CA for localhost).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# /api/health → api:4000/health
	handle_path /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	log
}
