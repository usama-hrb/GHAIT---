# Copy to .env (`make up` does it on first run) and adjust. Never commit .env.
# One file serves both stacks: infra/docker/compose.dev.yml and infra/docker/compose.prod.yml.
# Keep comments on their own line: scripts read values verbatim (KEY=value, no quotes, no trailing comments).

# ─── PostgreSQL (dev + prod) ─────────────────────────────────────────────────
# Database superuser created on the first start of an empty volume.
POSTGRES_USER=fabric
# Prod: generate with `openssl rand -hex 24`. Must be URL-safe (letters, digits, - _ .):
# it is embedded in DATABASE_URL by the compose files.
POSTGRES_PASSWORD=change-me
# Application database name.
POSTGRES_DB=fabric_shop

# ─── API runtime (validated by apps/api/src/config/env.ts) ───────────────────
# In Docker the compose files set these; the values below are only used when running
# the API on the host (`pnpm --filter @fabric/api dev`), against the dockerised Postgres.
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# postgres:// connection string.
DATABASE_URL=postgres://fabric:change-me@localhost:5440/fabric_shop
# Apply pending migrations when the API starts (the compose files set true).
MIGRATE_ON_START=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Signs access tokens (HS256), at least 32 characters. Prod: `openssl rand -base64 48`.
# The API refuses to start in production while it still contains "change-me".
JWT_ACCESS_SECRET=dev-only-change-me-insecure-access-secret
# Optional, with their defaults:
#   ACCESS_TOKEN_TTL_SECONDS=900   access token lifetime (60–3600)
#   REFRESH_TOKEN_TTL_DAYS=30      refresh token lifetime (1–90)
#   AUTH_COOKIE_PATH=/api/auth     browser path of the auth routes (Caddy serves the API at /api)
#   AUTH_LOGIN_RATE_LIMIT=5        login attempts per client IP per minute

# ─── Dev host ports (compose.dev.yml, bound to 127.0.0.1) ───────────────────
# Postgres for host tools (psql, DB GUIs). 5432 is often taken by a local install.
POSTGRES_HOST_PORT=5440
# API → http://localhost:4000/health
API_HOST_PORT=4000
# Web → http://localhost:3000
WEB_HOST_PORT=3000

# ─── pgAdmin (dev only, `make up PROFILES=tools`) ────────────────────────────
# http://localhost:5050. Dev convenience only; never expose it.
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Production (compose.prod.yml) ───────────────────────────────────────────
# Public hostname served by Caddy, e.g. shop.example.com. `localhost` uses Caddy's local CA.
DOMAIN=localhost
# Contact email for Let's Encrypt certificate notices.
ACME_EMAIL=owner@example.com
# Host ports for Caddy. Use 80/443 on the server (needed for Let's Encrypt).
HTTP_PORT=80
HTTPS_PORT=443
# Tag for the fabric-shop-api / fabric-shop-web images.
IMAGE_TAG=latest

# ─── Backups (infra/scripts/backup.sh, docs/runbooks/backup.md) ─────────────
# Where dumps are written, relative to the repo root (or absolute).
BACKUP_DIR=./backups
# Number of most recent dumps to keep.
BACKUP_KEEP=14
