# Copy to .env (`make up` does it on first run) and adjust. Never commit .env.
# One file serves both stacks: infra/docker/compose.dev.yml and infra/docker/compose.prod.yml.
# Keep comments on their own line: scripts read values verbatim (KEY=value, no quotes, no trailing comments).

# ─── PostgreSQL (dev + prod) ─────────────────────────────────────────────────
# Database superuser created on the first start of an empty volume.
POSTGRES_USER=fabric
# Prod: generate with `openssl rand -hex 24`. Must be URL-safe (letters, digits, - _ .):
# it is embedded in DATABASE_URL by the compose files.
POSTGRES_PASSWORD=change-me
# Application database name.
POSTGRES_DB=fabric_shop

# ─── API runtime (validated by apps/api/src/config/env.ts) ───────────────────
# In Docker the compose files set these; the values below are only used when running
# the API on the host (`pnpm --filter @fabric/api dev`), against the dockerised Postgres.
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# postgres:// connection string.
DATABASE_URL=postgres://fabric:change-me@localhost:5440/fabric_shop
# Apply pending migrations when the API starts (the compose files set true): the one database, or,
# with MULTI_SHOP=true, the control database and then every shop that is not closed.
MIGRATE_ON_START=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Signs access tokens (HS256), at least 32 characters. Prod: `openssl rand -base64 48`.
# The API refuses to start in production while it still contains "change-me".
JWT_ACCESS_SECRET=dev-only-change-me-insecure-access-secret
# Optional, with their defaults:
#   ACCESS_TOKEN_TTL_SECONDS=900   access token lifetime (60–3600)
#   REFRESH_TOKEN_TTL_DAYS=30      refresh token lifetime (1–90)
#   AUTH_COOKIE_PATH=/api/auth     browser path of the auth routes (Caddy serves the API at /api)
#   AUTH_LOGIN_RATE_LIMIT=5        login attempts per client IP per minute
#   AUTH_REFRESH_RATE_LIMIT=30     token refreshes per client IP per minute (one per page load)
#   AUTH_REGISTER_RATE_LIMIT=5     first-owner sign-ups per client IP per minute
#   OWNER_SIGNUP_ENABLED=true      false closes /signup even on an empty database (create the owner with `make owner`)

# ─── Multi-shop (ADR 0029, docs/MULTI_SHOP_PLAN.md) ──────────────────────────
# false: one shop and one database (DATABASE_URL), as always. true: one database for each shop on
# the same PostgreSQL server, and a control database that lists the shops. When the API starts, it
# makes the control database if it is missing, so the database login must be allowed to create
# databases (the superuser of the Docker stack is). The compose files pass these values to the API.
# A server that already has a live shop: run `make shop-adopt SLUG=<name> HOST=<address>` first
# (with MULTI_SHOP still false), then set true. Without it no address finds the shop.
MULTI_SHOP=false
# Name of the control database (used only when MULTI_SHOP=true). Lower-case letters, digits and _.
# It must not be the database in DATABASE_URL.
CONTROL_DATABASE_NAME=fabric_control
# Connections each shop's pool may hold (used only when MULTI_SHOP=true). A pool opens its
# connections only when its shop is used, and idle ones close. 1 to 20. The server holds at most
# SHOP_POOL_MAX x (shops in use) connections, plus 3 for the control database: keep that under
# PostgreSQL's max_connections (100 by default).
SHOP_POOL_MAX=5
# The key that setup codes are hashed with (HMAC-SHA256; ADR 0029 section 6). A setup code is what
# lets a new shop's owner make the first owner account; `make shop-new` and `make shop-code` print
# one, once, and the server keeps only its hash. At least 32 characters, never shared, never in git:
#   openssl rand -base64 48
# Change it and every code that is waiting stops working (make shop-code makes a new one). Empty is
# allowed while MULTI_SHOP=false. With MULTI_SHOP=true the API does not start without it, because
# the sign-up of a shop checks its code with it; the commands that make a code refuse too.
SETUP_CODE_SECRET=
# The domain that the shops' addresses are made under (production only, with MULTI_SHOP=true). A
# shop at `aziz.<this>` gets its own HTTPS certificate when it is first opened, from Let's Encrypt,
# if `make shop-new` made it: no change to Caddy and no restart. Needs one wildcard DNS record,
# `*.<this>` (type A, and AAAA for IPv6), pointing at the server; see docs/runbooks/deploy.md. Let's
# Encrypt allows 50 certificates a week for each registered domain, so that is also the most shops
# that can be opened for the first time in a week. `make shop-new SLUG=aziz` uses `aziz.<this>` as
# the address when HOST= is not given. Leave it empty on a one-shop server.
PLATFORM_DOMAIN=

# ─── Dev host ports (compose.dev.yml, bound to 127.0.0.1) ───────────────────
# Postgres for host tools (psql, DB GUIs). 5432 is often taken by a local install.
POSTGRES_HOST_PORT=5440
# API → http://localhost:4000/health
API_HOST_PORT=4000
# Web → http://localhost:3000
WEB_HOST_PORT=3000

# ─── pgAdmin (dev only, `make up PROFILES=tools`) ────────────────────────────
# http://localhost:5050. Dev convenience only; never expose it.
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Production (compose.prod.yml) ───────────────────────────────────────────
# On the server, uncomment this line so a plain `make up` (and every other make target) runs
# the production stack. Leave it commented on a development machine.
# STACK=prod
# Public hostname served by Caddy, e.g. shop.example.com. `localhost` uses Caddy's local CA.
# A bare IP address (temporary, before a domain exists) also works: Caddy serves it over HTTPS with
# its own local CA, so the browser shows a certificate warning until that CA is installed on the
# device (docs/runbooks/deploy.md, "Temporary: by IP address").
DOMAIN=localhost
# Contact email for Let's Encrypt certificate notices.
ACME_EMAIL=owner@example.com
# Host ports for Caddy. Use 80/443 on the server (needed for Let's Encrypt).
HTTP_PORT=80
HTTPS_PORT=443
# Tag for the fabric-shop-api / fabric-shop-web images.
IMAGE_TAG=latest

# ─── Backups (infra/scripts/backup.sh, docs/runbooks/backup.md) ─────────────
# Where dumps are written, relative to the repo root (or absolute).
BACKUP_DIR=./backups
# Number of most recent dumps to keep for each database. With MULTI_SHOP=true that is each shop and
# the control database, each in its own folder under BACKUP_DIR (docs/runbooks/backup.md).
BACKUP_KEEP=14
# Prod stack only: the nightly backup service writes to <repo>/backups at BACKUP_AT (UTC), as this
# host user, who must own that directory (id -u / id -g on the server).
BACKUP_AT=02:30
BACKUP_UID=1000
BACKUP_GID=1000
